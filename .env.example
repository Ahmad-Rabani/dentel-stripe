# Leave empty to use local preview content while developing the UI.
# Set this to your Strapi origin (no trailing slash) when the CMS is running.
NEXT_PUBLIC_STRAPI_URL=

# Canonical site URL used for metadata and sitemaps.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Strapi API token. Do not prefix this with NEXT_PUBLIC_.
STRAPI_API_TOKEN=
